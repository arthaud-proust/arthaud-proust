---
// "Harvey ball" : cercle rempli selon le niveau de passeport.dev (1, 2, 3 ou 5)
interface Props {
    level: number;
    label: string;
}

const { level, label } = Astro.props;

const FILL: Record<number, number> = { 1: 0, 2: 1 / 3, 3: 2 / 3, 5: 1 };
// Le secteur est dessiné par un trait épais (largeur = diamètre) sur un cercle de rayon 3.5
const C = 2 * Math.PI * 3.5;
---

<svg viewBox="0 0 16 16" width="16" height="16" role="img" aria-label={label}>
    <title>{label}</title>
    <circle cx="8" cy="8" r="7" class="ring" />
    {
        FILL[level] > 0 && (
            <circle
                cx="8"
                cy="8"
                r="3.5"
                class="fill"
                stroke-dasharray={`${FILL[level] * C} ${C}`}
                transform="rotate(-90 8 8)"
            />
        )
    }
</svg>

<style lang="sass">
    @use "../assets/styles/variables"

    svg
        flex-shrink: 0

    .ring
        fill: none
        stroke: variables.$primary
        stroke-width: 1.5

    .fill
        fill: none
        stroke: variables.$primary
        stroke-width: 7
</style>
