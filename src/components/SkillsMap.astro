---
// Reproduction du "Skills map" de passeport.dev : un secteur par catégorie,
// empilé de 1 à 5 anneaux selon le score de la catégorie.
import passeport from "../data/passeport.json";

// Ordre (sens horaire depuis midi) repris de passeport.dev. Couleurs adaptées pour l'accessibilité :
// toutes uniques, contraste >= 4.5:1 sur le fond (les libellés sont de la couleur du secteur),
// et secteurs voisins distincts en protanopie, deutéranopie et tritanopie
// (simulation Machado 2009, deltaE >= 20).
const CATEGORIES: [string, string][] = [
    ["Continuous Integration", "#0EAD69"],
    ["Observability", "#FFDA3E"],
    ["Software Documentation", "#FF5C7A"],
    ["Programming", "#6B93FF"],
    ["Cloud Infrastructure & Network", "#F2CEE6"],
    ["System Design & Architecture", "#C77DBB"],
    ["Data Science & Machine Learning", "#FF6700"],
    ["Data Engineering", "#61DAFB"],
    ["API Design", "#E0E0E0"],
    ["Frontend", "#4C9AFF"],
    ["Mobile Development", "#C5E063"],
    ["Application Testing", "#FF8FB1"],
];

// shortcut: formule déduite du rendu de passeport.dev (elle redonne les 12 secteurs observés
// le 28/11/2026), pas de leur code. À revoir si un secteur ne correspond plus après un export.
const POINTS: Record<number, number> = { 1: 0, 2: 1, 3: 3, 5: 5 };
function rings(category: string) {
    const levels = passeport.skills
        .filter((s) => s.category === category)
        .map((s) => POINTS[s.level]);
    const avg = levels.reduce((a, b) => a + b, 0) / levels.length;
    return Math.min(5, Math.round(avg) + 1);
}

const RING = 34.229;
const SLICE = (2 * Math.PI) / CATEGORIES.length;

const point = (r: number, a: number) =>
    `${(r * Math.sin(a)).toFixed(2)},${(-r * Math.cos(a)).toFixed(2)}`;

function ringPath(k: number, i: number) {
    const r0 = k === 0 ? 4 : RING * k + 4;
    const r1 = RING * (k + 1) + 2;
    const a0 = i * SLICE;
    const a1 = a0 + SLICE;
    return `M${point(r0, a0)}L${point(r1, a0)}A${r1},${r1},0,0,1,${point(r1, a1)}L${point(r0, a1)}A${r0},${r0},0,0,0,${point(r0, a0)}Z`;
}

// Retour à la ligne par mots, pour que les libellés voisins ne se chevauchent pas
function wrap(label: string, max = 16) {
    return label.split(" ").reduce<string[]>((lines, word) => {
        const last = lines.at(-1);
        if (last && `${last} ${word}`.length <= max) lines[lines.length - 1] = `${last} ${word}`;
        else lines.push(word);
        return lines;
    }, []);
}

const sectors = CATEGORIES.map(([name, color], i) => {
    const count = rings(name);
    const mid = (i + 0.5) * SLICE;
    return {
        name,
        color,
        count,
        paths: Array.from({ length: count }, (_, k) => ringPath(k, i)),
        lines: wrap(name),
        // Niveaux non atteints : trait fin au milieu du secteur, coupé comme les anneaux
        guide: Array.from(
            { length: 5 - count },
            (_, n) => count + n,
        )
            // +1/-1 : le contour de 2px des anneaux mange 1px de chaque côté, même espace visible
            .map((k) => `M${point((k === 0 ? 4 : RING * k + 4) + 1, mid)}L${point(RING * (k + 1) + 2 - 1, mid)}`)
            .join(""),
        x: 235 * Math.sin(mid),
        y: -235 * Math.cos(mid),
    };
});
---

<figure>
    <svg
        viewBox="-320 -280 640 560"
        role="img"
        aria-label={`Carte des compétences : ${sectors.map((s) => `${s.name} ${s.count}/5`).join(", ")}`}
    >
        {
            sectors.map((s) => (
                <g fill={s.color}>
                    <title>{`${s.name} : ${s.count}/5`}</title>
                    {s.paths.map((d) => (
                        <path d={d} />
                    ))}
                    {s.guide && <path class="guide" d={s.guide} style={`stroke: ${s.color}`} />}
                    <text x={s.x} y={s.y} style={`fill: ${s.color}`}>
                        {s.lines.map((line, n) => (
                            <tspan x={s.x} dy={n === 0 ? `${-(s.lines.length - 1) * 0.6}em` : "1.2em"}>
                                {line}
                            </tspan>
                        ))}
                    </text>
                </g>
            ))
        }
    </svg>
</figure>

<style lang="sass">
    figure
        margin-top: 3rem
        padding: 1rem
        border-radius: 1rem
        background: #252525

    svg
        display: block
        width: 100%
        height: auto

    path
        stroke: #252525
        stroke-width: 2

    path.guide
        stroke-width: 1
        opacity: .5

    text
        font-size: 14px
        text-anchor: middle
        dominant-baseline: middle
</style>
