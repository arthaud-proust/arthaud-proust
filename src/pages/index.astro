---
import portrait from "@/assets/images/arthaud-proust-portrait.jpg";
import Layout from "@/layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import { Content as ReadmeContent } from "~/README.md";
---

<Layout>
    <Image
        src={portrait}
        alt=""
        widths={[300]}
        quality={"max"}
        sizes={`300px`}
    />
    <ReadmeContent />
</Layout>
